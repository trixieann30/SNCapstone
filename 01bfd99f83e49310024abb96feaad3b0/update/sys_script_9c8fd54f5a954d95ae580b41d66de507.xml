        <script><![CDATA[var utils = new DeskMateUtils();
try {
    var aiService = new DeskMateAIService();
    var knowledgeService = new DeskMateKnowledgeService();

    aiService.classifyIncident(current);
    aiService.suggestAssignmentGroup(current);

    var articles = knowledgeService.findRelevantArticles(current, 3);
    if (articles) {
        for (var i = 0; i < articles.length; i++) {
            knowledgeService.createArticleSuggestion(current, articles[i].sys_id, articles[i].score);
        }
    }
} catch (e) {
    utils.logError('DeskMate - AI Classify New Incident failed: ' + e.message);
}
]]></script>
